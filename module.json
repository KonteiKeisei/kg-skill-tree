{
  "id": "kg-skill-tree",
  "title": "KG Skill Trees",
  "description": "Design skill trees on any background image, unlock them for characters, and let players spend points earned from level ups and other events on feats, items and summons. Adds a Skill Tree tab to dnd5e and Tidy 5e character sheets.",
  "version": "0.3.6",
  "license": "LICENSE",
  "readme": "https://github.com/KonteiKeisei/kg-skill-tree#readme",
  "url": "https://github.com/KonteiKeisei/kg-skill-tree",
  "bugs": "https://github.com/KonteiKeisei/kg-skill-tree/issues",
  "changelog": "https://github.com/KonteiKeisei/kg-skill-tree/blob/main/CHANGELOG.md",
  "manifest": "https://github.com/KonteiKeisei/kg-skill-tree/releases/latest/download/module.json",
  "download": "https://github.com/KonteiKeisei/kg-skill-tree/releases/download/v0.3.6/kg-skill-tree-0.3.6.zip",
  "compatibility": {
    "minimum": "13",
    "verified": "14",
    "maximum": "14"
  },
  "authors": [
    {
      "name": "Konte"
    }
  ],
  "relationships": {
    "systems": [
      {
        "id": "dnd5e",
        "type": "system",
        "compatibility": {
          "minimum": "5.3.3"
        }
      }
    ],
    "recommends": [
      {
        "id": "tidy5e-sheet",
        "type": "module",
        "reason": "The Skill Tree tab also appears on Tidy 5e character sheets."
      },
      {
        "id": "kg-pc-history",
        "type": "module",
        "reason": "Skill tree purchases are recorded in the character's history."
      }
    ]
  },
  "esmodules": [
    "scripts/main.mjs"
  ],
  "socket": true,
  "styles": [
    "styles/skill-tree.css"
  ],
  "languages": []
}
